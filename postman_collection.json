        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_name\": \"Gaming Laptop\",\n  \"category\": \"Electronics\",\n  \"price\": 80000,\n  \"quantity\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Name updated', () => pm.expect(pm.response.json().product_name).to.eql('Gaming Laptop'));"
            ]
          }
        }
      ]
    },

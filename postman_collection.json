{
  "info": {
    "name": "Product Management API",
    "description": "Start the server first, then run the folder top-to-bottom (Collection Runner). Starts and ends with an empty database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/products"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"product_name\": \"Laptop\",\n  \"category\": \"Electronics\",\n  \"price\": 55000,\n  \"quantity\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create product - duplicate ID (409)",
      "request": {
        "method": "POST",
        "header": [
          {
